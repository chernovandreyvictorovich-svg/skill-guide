<?xml version="1.0" encoding="UTF-8"?>
<!-- Шаблон. Реальный plist генерируется scripts/install-autoupdate.sh:
     __LABEL__, __PROJECT_DIR__, __HOME__ подставляются под текущую машину. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/update.sh</string>
  </array>

  <!-- Пересобрать при входе в систему -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Пересобрать, как только меняется любая из папок скиллов -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.claude/skills</string>
    <string>__HOME__/.agents/skills</string>
    <string>__HOME__/.claude/plugins/cache</string>
    <string>__HOME__/.codex/skills</string>
  </array>

  <!-- Не чаще раза в 10 секунд -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/update.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/update.log</string>
</dict>
</plist>
